---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Typewriter from "@components/Typewriter.astro";
import ParticleBackground from "@components/ParticleBackground.astro";
import ScrambleText from "@components/ScrambleText.astro";
import ProfileCard from "@components/ProfileCard.astro";
import TagCloud from "@components/TagCloud.astro";
import Calendar from "@components/Calendar.astro";
import GlassCard from "@components/GlassCard.astro";
import { dateRange, venueBadge } from "@lib/utils";
import { SITE, HOME, SOCIALS } from "@consts";
import { Image } from "astro:assets";
import heroImage from "../assets/hero.webp";

const allBlog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const finalReviewBlog = allBlog.filter(post => post.data.column === "期末复习");
const nonInvestmentBlog = allBlog.filter(post => post.data.series !== "黄金投资日报" && post.data.column !== "期末复习");
const investmentBlog = allBlog.filter(post => post.data.series === "黄金投资日报");

const blog = nonInvestmentBlog.slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);
const marketNotes = investmentBlog.slice(0, 2);
const finalReviews = finalReviewBlog.slice(0, 3);

const allProjects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const projects = allProjects.slice(0,SITE.NUM_PROJECTS_ON_HOMEPAGE);

const allwork = (await getCollection("work"))
  .sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf())
  .slice(0,SITE.NUM_WORKS_ON_HOMEPAGE);

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);

---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <ParticleBackground />
  <Container>
    <!-- Hero Section with Typewriter -->
    <section class="min-h-[40vh] flex flex-col justify-center mb-16">
      <div class="space-y-6">
        <!-- Hero Image -->
        <div class="animate w-full max-w-3xl mx-auto mb-8">
          <div class="group relative">
            {/* Ambient gradient glow */}
            <div
              class="absolute -inset-3 rounded-3xl bg-gradient-to-r from-blue-500/25 via-purple-500/25 to-pink-500/25 blur-2xl opacity-60 dark:opacity-40 group-hover:opacity-90 dark:group-hover:opacity-60 transition-opacity duration-500 pointer-events-none"
              aria-hidden="true"
            ></div>
            <div class="relative rounded-2xl overflow-hidden ring-1 ring-black/10 dark:ring-white/15 shadow-xl hover:shadow-2xl transition-shadow duration-300">
              <Image 
                src={heroImage} 
                alt="Schedule February"
                class="w-full h-auto object-cover"
                width={1200}
                height={600}
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </div>
          </div>
        </div>
        
        <div class="animate">
          <span class="badge-tech">
            👋 Welcome to my Blog.
          </span>
        </div>
        
        <h1 class="animate animate-delay-100 text-4xl md:text-6xl font-bold text-black dark:text-white leading-tight">
          Hi, I'm <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-purple-600 animate-gradient">Yanqiao Chen</span>
        </h1>
        
        <div class="animate animate-delay-200 text-xl md:text-2xl text-black/60 dark:text-white/60 h-8">
          <Typewriter text="Symbol · Language · Theory" speed={80} />
        </div>
        
        <p class="animate animate-delay-300 text-lg text-black/50 dark:text-white/50 max-w-2xl leading-relaxed">
           This is my blog for my technical notes, project updates and publications.
        </p>
        
        <div class="animate animate-delay-400 flex flex-wrap gap-4 pt-4">
          <a href="/blog" class="btn-glass-primary magnetic-btn">
            Read My Blogs
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a href="/projects" class="btn-glass magnetic-btn">
            See My Projects
          </a>
        </div>
      </div>
    </section>

    <div class="grid grid-cols-1 xl:grid-cols-[1fr_280px] gap-12 relative z-10">
      <!-- Main Content -->
      <div class="space-y-16">
      <!-- Featured Section with Glass Cards -->
      <section class="animate grid md:grid-cols-2 gap-6 items-start">
        <GlassCard glow padding="p-5 sm:p-6" class="md:col-span-2">
          <div class="flex items-start gap-3 sm:gap-4">
            <div class="text-4xl animate-float flex-shrink-0">🎯</div>
            <div class="min-w-0 w-full">
              <h3 class="text-xl font-bold text-black dark:text-white mb-2">
                <ScrambleText text="Research Focus" />
              </h3>
              <p class="text-black/75 dark:text-white/80 text-sm leading-relaxed break-words">
                Context Engineering and Reinforcement Learning. Apart from that, I am also interested in the scaling optimization method design and the theoretical aspects of deep learning and the interpretability of large language models. 
              </p>
            </div>
          </div>
        </GlassCard>

        <a href="/blog/column/期末复习" class="block group h-full">
          <GlassCard class="h-full" glow>
            <div class="text-center">
              <div class="text-4xl mb-3 animate-pulse-glow group-hover:scale-110 transition-transform duration-300">🎓</div>
              <div class="text-lg font-bold text-black dark:text-white mb-1">Final Review</div>
              <div class="text-sm text-black/65 dark:text-white/75">期末复习专栏</div>
            </div>
          </GlassCard>
        </a>
        
        <a href="/blog/columns" class="block group h-full">
          <GlassCard class="h-full">
            <div class="text-center">
              <div class="text-4xl mb-3 animate-pulse-glow group-hover:scale-110 transition-transform duration-300">📂</div>
              <div class="text-lg font-bold text-black dark:text-white mb-1">Browse Columns</div>
              <div class="text-sm text-black/65 dark:text-white/75">按专栏浏览笔记</div>
            </div>
          </GlassCard>
        </a>
      </section>

      <!-- Latest Posts -->
      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="section-title flex items-center gap-2">
            <span class="animate-float inline-block">📝</span>
            What's New?
          </h2>
          <a href="/blog" class="btn-glass text-xs py-1.5">
            View All →
          </a>
        </div>
        <ul class="flex flex-col gap-4 w-full">
          {blog.map((post, index) => (
            <li class={`animate animate-delay-${(index + 1) * 100} w-full overflow-hidden`}>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>

      <!-- Final Reviews -->
      {finalReviews.length > 0 && (
        <section class="animate space-y-6">
          <div class="flex flex-wrap gap-y-2 items-center justify-between">
            <h2 class="section-title flex items-center gap-2">
              <span class="animate-float inline-block" style="animation-delay: 0.3s;">🎓</span>
              Final Reviews
            </h2>
            <a href="/blog/column/期末复习" class="btn-glass text-xs py-1.5">
              View All →
            </a>
          </div>
          <ul class="flex flex-col gap-4 w-full">
            {finalReviews.map((post, index) => (
              <li class={`animate animate-delay-${(index + 1) * 100} w-full overflow-hidden`}>
                <ArrowCard entry={post} />
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Market Notes -->
      {marketNotes.length > 0 && (
        <section class="animate space-y-6">
          <div class="flex flex-wrap gap-y-2 items-center justify-between">
            <h2 class="section-title flex items-center gap-2">
              <span class="animate-float inline-block" style="animation-delay: 0.7s;">📈</span>
              Market Notes
            </h2>
            <a href="/blog/column/投资" class="btn-glass text-xs py-1.5">
              View All →
            </a>
          </div>
          <ul class="flex flex-col gap-4 w-full">
            {marketNotes.map((post, index) => (
              <li class={`animate animate-delay-${(index + 1) * 100} w-full overflow-hidden`}>
                <ArrowCard entry={post} />
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Work Experience -->
      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="section-title flex items-center gap-2">
            <span class="animate-float inline-block" style="animation-delay: 0.5s;">💼</span>
            My Work in Research
          </h2>
          <a href="/work" class="btn-glass text-xs py-1.5">
            View All →
          </a>
        </div>
        <div class="grid gap-6">
          {work.map((entry, index) => (
            <GlassCard glow class={`animate hover-lift ${index % 2 === 0 ? 'animate-slide-left' : 'animate-slide-right'}`} style={`animation-delay: ${index * 100}ms`} padding="p-6 md:p-8">
              <div class="flex flex-wrap gap-2 items-center text-sm mb-3">
                <span class="badge-tech">
                  {dateRange(entry.data.dateStart, entry.data.dateEnd)}
                </span>
                {entry.data.venue && (
                  <span class={`badge-tech ${venueBadge(entry.data.venue)}`}>
                    {entry.data.venue}
                  </span>
                )}
                {entry.data.status && (
                  <span class="badge-tech">
                    {entry.data.status}
                  </span>
                )}
              </div>
              <h3 class="text-lg font-bold text-black dark:text-white mb-1 text-gradient-subtle">
                {entry.data.company}
              </h3>
              <p class="text-sm text-black/60 dark:text-white/70 mb-4">{entry.data.role}</p>
              <article class="prose-sm">
                <entry.Content />
              </article>
            </GlassCard>
          ))}
        </div>
      </section>

      <!-- Recent Projects -->
      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="section-title flex items-center gap-2">
            <span class="animate-float inline-block" style="animation-delay: 1s;">🚀</span>
            Recently, I am working on...
          </h2>
          <a href="/projects" class="btn-glass text-xs py-1.5">
            View All →
          </a>
        </div>
        <ul class="grid md:grid-cols-2 gap-4 w-full">
          {projects.map((project, index) => (
            <li class={`animate animate-scale-in min-w-0 overflow-hidden`} style={`animation-delay: ${index * 150}ms`}>
              <ArrowCard entry={project} />
            </li>
          ))}
        </ul>
      </section>

      <!-- Connect Section -->
      <section class="animate space-y-6">
        <h2 class="section-title flex items-center gap-2">
          <span class="animate-float inline-block" style="animation-delay: 1.5s;">🤝</span>
          Keep in Touch...
        </h2>
        <GlassCard glow padding="p-6 md:p-8">
          <p class="text-lg mb-6 text-black/65 dark:text-white/75">
            Feel Free to Contact Me via: 👇
          </p>
          <div class="flex flex-wrap gap-3">
            {SOCIALS.map((SOCIAL, index) => (
              <a 
                href={SOCIAL.HREF} 
                target="_blank" 
                rel="noopener noreferrer"
                class="btn-glass magnetic-btn"
                style={`animation-delay: ${index * 50}ms`}
              >
                <span class="capitalize">{SOCIAL.NAME}</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
                </svg>
              </a>
            ))}
            <a 
              href={`mailto:${SITE.EMAIL}`}
              class="btn-glass-primary magnetic-btn"
            >
              <span>Email</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </a>
          </div>
        </GlassCard>
      </section>
      </div>
      
      <!-- Sidebar -->
      <aside class="hidden xl:block">
        <div class="sticky top-24 space-y-10 pb-8">
          <ProfileCard postCount={allBlog.length} projectCount={allProjects.length} pubCount={allwork.length} />
          <Calendar importantDates={[
            { date: "2026-07-21", title: "AAAI 2027 Abstract", type: "deadline" },
            { date: "2026-07-28", title: "AAAI 2027 Full Paper", type: "deadline" },
            { date: "2026-07-31", title: "AAAI 2027 Supplementary", type: "deadline" },
            { date: "2026-09-19", title: "ICLR 2027 Abstract", type: "deadline" },
            { date: "2026-09-24", title: "ICLR 2027 Full Paper", type: "deadline" },
            { date: "2026-12-02", title: "NeurIPS 2026", type: "event" }
          ]} />
          <TagCloud />
          
          <!-- Quick Links -->
          <GlassCard>
            <h3 class="text-sm font-bold text-black dark:text-white mb-4">Quick Links</h3>
            <div class="flex flex-wrap gap-2">
              <a href="/blog" class="badge-tech text-xs">Latest Posts</a>
              <a href="/projects" class="badge-tech text-xs">Projects</a>
              <a href="/about" class="badge-tech text-xs">About Me</a>
              <a href="/work" class="badge-tech text-xs">Research</a>
              <a href="/blog/columns" class="badge-tech text-xs">Columns</a>
              <a href="/blog/tags" class="badge-tech text-xs">Tags</a>
              <a href="/blog/archive" class="badge-tech text-xs">Archive</a>
            </div>
          </GlassCard>
        </div>
      </aside>
    </div>
  </Container>
</PageLayout>

<script>
  // Magnetic button effect (rAF-throttled)
  document.querySelectorAll('.magnetic-btn').forEach(btn => {
    const el = btn as HTMLElement;
    let rafId = 0;
    let targetX = 0;
    let targetY = 0;

    const apply = () => {
      rafId = 0;
      el.style.transform = `translate(${targetX}px, ${targetY}px)`;
    };

    el.addEventListener('mousemove', (e: Event) => {
      const rect = el.getBoundingClientRect();
      const mouseEvent = e as MouseEvent;
      targetX = (mouseEvent.clientX - rect.left - rect.width / 2) * 0.1;
      targetY = (mouseEvent.clientY - rect.top - rect.height / 2) * 0.1;
      if (!rafId) rafId = requestAnimationFrame(apply);
    });

    el.addEventListener('mouseleave', () => {
      if (rafId) {
        cancelAnimationFrame(rafId);
        rafId = 0;
      }
      el.style.transform = 'translate(0, 0)';
    });
  });
</script>
