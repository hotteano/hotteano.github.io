---

<PageLayout title={ABOUT.TITLE} description={ABOUT.DESCRIPTION}>
  <Container>
    <div class="grid grid-cols-1 xl:grid-cols-[1fr_280px] gap-12 relative">
      <!-- Main Content -->
      <div class="space-y-20">
        <!-- Hero -->
        <section id="about-me" class="animate space-y-6">
          <div class="flex flex-col md:flex-row gap-8 items-start">
            <div class="animate animate-scale-in shrink-0">
              <div
                class="w-32 h-32 md:w-40 md:h-40 rounded-full bg-gradient-to-br from-blue-500 via-purple-500 to-pink-500 p-1 hover-lift overflow-hidden"
              >
                <Image
                  src={avatarImage}
                  alt={SITE.NAME}
                  class="w-full h-full rounded-full object-cover"
                  width={160}
                  height={160}
                />
              </div>
            </div>

            <div class="flex-1 space-y-4">
              <h1
                class="animate animate-delay-100 text-3xl md:text-4xl font-bold text-black dark:text-white"
              >
                {SITE.NAME}
              </h1>

              <p
                class="animate animate-delay-200 text-lg text-black/60 dark:text-white/60 leading-relaxed"
              >
                Undergraduate student in the Turing Class, Department of
                Computer Science and Engineering, Southern University of Science
                and Technology (SUSTech). My research lies at the intersection
                of optimization theory, machine learning, and artificial
                intelligence.
              </p>

              <div class="animate animate-delay-250 flex flex-wrap gap-2">
                {
                  identityBadges.map((badge) => (
                    <span
                      class={`px-3 py-1.5 rounded-full text-sm font-medium border bg-gradient-to-r backdrop-blur-sm ${badge.color} hover:scale-105 transition-transform`}
                    >
                      {badge.label}
                    </span>
                  ))
                }
              </div>

              <div class="animate animate-delay-300 flex flex-wrap gap-3 pt-2">
                <a
                  href={`mailto:${SITE.EMAIL}`}
                  class="btn-glass-primary magnetic-btn"
                >
                  Get in Touch
                </a>
                <a
                  href="/work"
                  class="btn-glass magnetic-btn"
                >
                  View My Work
                </a>
              </div>
            </div>
          </div>
        </section>

        <!-- About Me -->
        <section class="animate space-y-6">
          <h2
            class="section-title flex items-center gap-2"
          >
            <span class="animate-float inline-block">📖</span>
            About Me
          </h2>
          <div
            class="space-y-4 text-black/60 dark:text-white/60 leading-relaxed"
          >
            <p>
              I am currently an undergraduate student in the Turing Class at
              SUSTech, majoring in Computer Science and Engineering. My academic
              background combines rigorous training in algorithms, mathematics,
              and machine learning, with a growing research focus on theoretical
              aspects of optimization and intelligent systems.
            </p>
            <p>
              I am particularly interested in understanding the theoretical
              foundations that underpin modern AI systems, including
              optimization dynamics in deep learning, the behavior of
              evolutionary algorithms, decision-making in reinforcement
              learning, and the design principles of agentic systems.
            </p>
            <p>
              Please feel free to reach out if you are interested in my research
              or would like to discuss related topics.
            </p>
          </div>
        </section>

        <!-- Education -->
        <section id="education" class="animate space-y-6">
          <h2
            class="section-title flex items-center gap-2"
          >
            <span
              class="animate-float inline-block"
              style="animation-delay: 0.4s;">🎓</span
            >
            Education
          </h2>

          <div class="relative pl-6 md:pl-8 space-y-8">
            <div
              class="absolute left-0 top-2 bottom-2 w-0.5 bg-gradient-to-b from-indigo-500/30 via-sky-500/30 to-transparent"
            >
            </div>
            {
              education.map((edu, index) => (
                <div
                  class="relative animate"
                  style={`animation-delay: ${index * 100}ms`}
                >
                  <div
                    class={`absolute -left-6 md:-left-8 top-1.5 w-3 h-3 rounded-full ${edu.dotClass} ring-4 ring-white dark:ring-stone-900`}
                  />
                  <GlassCard class="hover-lift" padding="p-5">
                    <div class="flex flex-wrap gap-2 items-center text-sm text-black/40 dark:text-white/40 mb-2">
                      <span>{edu.period}</span>
                      <span
                        class={`px-2 py-0.5 rounded-full text-xs font-medium border backdrop-blur-sm ${edu.badgeClass}`}
                      >
                        {edu.role}
                      </span>
                    </div>
                    <h3 class="font-bold text-black dark:text-white text-lg mb-1 text-gradient-subtle">
                      {edu.school}
                    </h3>
                    <p class="text-black/65 dark:text-white/75">
                      {edu.description}
                    </p>
                  </GlassCard>
                </div>
              ))
            }
          </div>
        </section>

        <!-- Research & Experience -->
        <section id="research" class="animate space-y-6">
          <h2
            class="section-title flex items-center gap-2"
          >
            <span
              class="animate-float inline-block"
              style="animation-delay: 0.47s;">🔬</span
            >
            Research & Experience
          </h2>

          <div class="space-y-4">
            {
              researchItems.map((item, index) => (
                <GlassCard glow={index === 0} class="hover-lift" style={`animation-delay: ${index * 100}ms`} padding="p-5 md:p-6">
                  <div class="flex flex-wrap gap-2 items-center text-sm text-black/40 dark:text-white/40 mb-2">
                    <span>{item.period}</span>
                    <span class="badge-tech text-xs">
                      {item.role}
                    </span>
                  </div>
                  <h3 class="font-bold text-black dark:text-white text-lg mb-2 text-gradient-subtle">
                    {item.title}
                  </h3>
                  <p class="text-black/65 dark:text-white/75 leading-relaxed mb-3">
                    {item.description}
                  </p>
                  <div class="flex flex-wrap gap-2">
                    {item.tags.map((tag) => (
                      <span class="badge-tech text-xs">
                        {tag}
                      </span>
                    ))}
                  </div>
                </GlassCard>
              ))
            }
          </div>
        </section>

        <!-- Skills & Knowledge -->
        <section id="skills" class="animate space-y-6">
          <div class="grid md:grid-cols-2 gap-8">
            <!-- Skills -->
            <div class="space-y-4">
              <h2
                class="section-title flex items-center gap-2"
              >
                <span
                  class="animate-float inline-block"
                  style="animation-delay: 0.5s;">🛠️</span
                >
                Skills
              </h2>
              <div class="grid grid-cols-2 gap-3">
                {
                  skills.map((skill, index) => (
                    <GlassCard
                      class="animate hover-lift"
                      style={`animation-delay: ${index * 50}ms`}
                      padding="p-3"
                    >
                      <div
                        class={`w-9 h-9 rounded-xl bg-gradient-to-br ${skill.color} flex items-center justify-center text-base mb-2 shadow-lg`}
                      >
                        {skill.emoji}
                      </div>
                      <h3 class="font-semibold text-black dark:text-white text-sm">
                        {skill.name}
                      </h3>
                    </GlassCard>
                  ))
                }
              </div>
            </div>

            <!-- Knowledge -->
            <div class="space-y-4">
              <h2
                class="section-title flex items-center gap-2"
              >
                <span
                  class="animate-float inline-block"
                  style="animation-delay: 0.6s;">📚</span
                >
                Knowledge
              </h2>
              <div class="space-y-4">
                {
                  knowledgeGroups.map((group, gIndex) => (
                    <div
                      class="animate"
                      style={`animation-delay: ${gIndex * 100}ms`}
                    >
                      <div class="text-sm font-medium text-black/50 dark:text-white/50 mb-2">
                        {group.category}
                      </div>
                      <div class="flex flex-wrap gap-2">
                        {group.items.map((item, index) => (
                          <span
                            class="badge-tech text-sm"
                            style={`animation-delay: ${index * 30}ms`}
                          >
                            {item}
                          </span>
                        ))}
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </section>

        <!-- Publications & Appointments -->
        <section id="publications" class="animate space-y-6">
          <div class="grid md:grid-cols-2 gap-8">
            <!-- Publications -->
            <div class="space-y-4">
              <h2
                class="section-title flex items-center gap-2"
              >
                <span
                  class="animate-float inline-block"
                  style="animation-delay: 1.2s;">📚</span
                >
                Publications
              </h2>
              <div class="space-y-3">
                {
                  publications.map((pub, index) => (
                    <GlassCard
                      class="animate hover-lift"
                      style={`animation-delay: ${index * 100}ms`}
                      padding="p-4"
                    >
                      <div class="flex flex-wrap items-center gap-2 mb-2">
                        <span class="text-sm text-black/40 dark:text-white/40">
                          {pub.year}
                        </span>
                        <span
                          class={`px-2 py-0.5 rounded-full text-xs font-medium border backdrop-blur-sm ${pub.statusColor}`}
                        >
                          {pub.status}
                        </span>
                      </div>
                      <p class="text-sm text-black/70 dark:text-white/70 mb-1">
                        {pub.authors}
                      </p>
                      <p class="text-sm text-black/45 dark:text-white/55">
                        {pub.venue}
                      </p>
                    </GlassCard>
                  ))
                }
              </div>
            </div>

            <!-- Appointments -->
            <div class="space-y-4">
              <h2
                class="section-title flex items-center gap-2"
              >
                <span
                  class="animate-float inline-block"
                  style="animation-delay: 1.3s;">🏛️</span
                >
                Appointments
              </h2>
              <div class="space-y-3">
                {
                  appointments.map((app, index) => (
                    <GlassCard
                      class="animate hover-lift"
                      style={`animation-delay: ${index * 100}ms`}
                      padding="p-4"
                    >
                      <div class="text-sm text-black/40 dark:text-white/40 mb-1">
                        {app.period}
                      </div>
                      <h3 class="font-bold text-black dark:text-white mb-1 text-gradient-subtle">
                        {app.role}
                      </h3>
                      <p class="text-sm text-black/65 dark:text-white/75 mb-2">
                        {app.org}
                      </p>
                      <p class="text-sm text-black/55 dark:text-white/65">
                        {app.description}
                      </p>
                    </GlassCard>
                  ))
                }
              </div>
            </div>
          </div>
        </section>

        <!-- Honors & Awards -->
        <section id="awards" class="animate space-y-6">
          <h2
            class="section-title flex items-center gap-2"
          >
            <span
              class="animate-float inline-block"
              style="animation-delay: 2.1s;">🏆</span
            >
            Honors & Awards
          </h2>

          <div class="grid md:grid-cols-2 gap-4">
            <!-- GPA Featured -->
            <GlassCard
              glow
              class="animate hover-lift md:col-span-2"
              padding="p-6"
            >
              <div class="flex flex-col md:flex-row md:items-center gap-6">
                <div class="text-5xl">📊</div>
                <div class="flex-1">
                  <div class="text-sm text-black/50 dark:text-white/50 mb-1">
                    Cumulative GPA
                  </div>
                  <h3
                    class="text-3xl font-bold text-black dark:text-white mb-2"
                  >
                    3.83 / 4.0
                  </h3>
                  <div
                    class="grid grid-cols-2 md:grid-cols-4 gap-2 text-sm text-black/60 dark:text-white/60"
                  >
                    <span>Fall 2024: 3.72</span>
                    <span>Spring 2024: 3.91</span>
                    <span>Fall 2025: 3.85</span>
                    <span>Spring 2026: 3.83</span>
                  </div>
                </div>
              </div>
            </GlassCard>

            {
              awards.map((award, index) => (
                <GlassCard
                  class="animate hover-lift"
                  style={`animation-delay: ${(index + 1) * 100}ms`}
                  padding="p-5"
                >
                  <div class="flex items-start gap-4">
                    <div class="text-3xl">{award.icon}</div>
                    <div class="flex-1">
                      <div class="text-sm text-black/40 dark:text-white/40 mb-1">
                        {award.year}
                      </div>
                      <h3 class="font-semibold text-black dark:text-white mb-1">
                        {award.title}
                      </h3>
                      <p class="text-sm text-black/50 dark:text-white/50">
                        {award.desc}
                      </p>
                    </div>
                  </div>
                </GlassCard>
              ))
            }

            <!-- English Proficiency -->
            <GlassCard
              class="animate hover-lift md:col-span-2"
              padding="p-5"
            >
              <div class="flex items-start gap-4">
                <div class="text-3xl">🌐</div>
                <div class="flex-1 min-w-0">
                  <div class="text-sm text-black/50 dark:text-white/50 mb-2">
                    English Proficiency
                  </div>
                  <div class="grid md:grid-cols-2 gap-4">
                    <div>
                      <h3
                        class="font-semibold text-black dark:text-white mb-2 text-sm"
                      >
                        Standardized Tests
                      </h3>
                      <ul
                        class="text-sm text-black/60 dark:text-white/60 space-y-1"
                      >
                        <li>
                          • CET-4: <span
                            class="font-medium text-black dark:text-white"
                            >620/710</span>
                        </li>
                        <li>
                          • CET-6: <span
                            class="font-medium text-black dark:text-white"
                            >624/710</span>
                        </li>
                        <li>
                          • TOEFL: <span
                            class="font-medium text-black dark:text-white"
                            >To be taken in 2026</span>
                        </li>
                      </ul>
                    </div>
                    <div>
                      <h3
                        class="font-semibold text-black dark:text-white mb-2 text-sm"
                      >
                        Academic Courses
                      </h3>
                      <ul
                        class="text-sm text-black/60 dark:text-white/60 space-y-1"
                      >
                        <li>
                          • SUSTech English II: <span
                            class="font-medium text-green-600 dark:text-green-400"
                            >A (96/100)</span>
                        </li>
                        <li>
                          • SUSTech English III: <span
                            class="font-medium text-green-600 dark:text-green-400"
                            >A+ (97/100)</span>
                        </li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </GlassCard>

            <!-- Key Course Grades -->
            <GlassCard
              class="animate hover-lift md:col-span-2"
              padding="p-5"
            >
              <div class="flex items-start gap-4">
                <div class="text-3xl">🎓</div>
                <div class="flex-1">
                  <div class="text-sm text-black/50 dark:text-white/50 mb-2">
                    Key Course Grades
                  </div>
                  <div
                    class="grid md:grid-cols-2 gap-x-6 gap-y-1 text-sm text-black/60 dark:text-white/60"
                  >
                    {
                      courseGrades.map((course) => (
                        <div class="flex justify-between py-1 border-b border-black/5 dark:border-white/5">
                          <span>{course.name}</span>
                          <span class="font-medium text-black dark:text-white">
                            {course.grade}
                          </span>
                        </div>
                      ))
                    }
                  </div>
                </div>
              </div>
            </GlassCard>
          </div>
        </section>

        <!-- Interests -->
        <section id="interests" class="animate space-y-6">
          <h2
            class="section-title flex items-center gap-2"
          >
            <span
              class="animate-float inline-block"
              style="animation-delay: 1s;">✨</span
            >
            Interests
          </h2>

          <div class="grid md:grid-cols-3 gap-4">
            {
              interests.map((item, index) => (
                <GlassCard
                  class="animate hover-lift"
                  style={`animation-delay: ${index * 100}ms`}
                  padding="p-5"
                >
                  <div class="text-3xl mb-3">{item.icon}</div>
                  <h3 class="font-bold text-black dark:text-white mb-2 text-gradient-subtle">
                    {item.title}
                  </h3>
                  <p class="text-sm text-black/60 dark:text-white/70">
                    {item.desc}
                  </p>
                </GlassCard>
              ))
