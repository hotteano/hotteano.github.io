const funFacts = [
  { label: "Location", value: "Shenzhen, Guangdong, China" },
  { label: "Favorite Algorithm", value: "Euclidean Algorithm" },
  {
    label: "Favorite Open Problem",
    value: "Karchmer-Raz-Wigderson Conjecture",
  },
