---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import Link from "@components/Link.astro";
import GlassCard from "@components/GlassCard.astro";
import { SITE, ABOUT, SOCIALS } from "@consts";
import { Image } from "astro:assets";
import avatarImage from "../assets/soci.png";

const sections = [
  { id: "about-me", label: "About Me" },
  { id: "education", label: "Education" },
  { id: "research", label: "Research" },
  { id: "skills", label: "Skills" },
  { id: "publications", label: "Publications" },
  { id: "awards", label: "Awards" },
  { id: "interests", label: "Interests" },
  { id: "contact", label: "Contact" },
];

const identityBadges = [
  { label: "Optimization Theory", color: "from-rose-500/10 to-pink-500/10 text-rose-600 dark:text-rose-400 border-rose-500/20" },
  { label: "Genetic Programming Theory", color: "from-amber-500/10 to-orange-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20" },
  { label: "Reinforcement Learning", color: "from-emerald-500/10 to-green-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20" },
  { label: "Agentic AI & Context Engineering", color: "from-sky-500/10 to-blue-500/10 text-sky-600 dark:text-sky-400 border-sky-500/20" },
];

const education = [
  {
    period: "2021 - 2024",
    role: "Middle School Student",
    school: "Shenzhen Middle School",
    description: "Top Middle School in China, where I developed my interest in computer science and mathematics.",
    dotClass: "bg-indigo-500 ring-indigo-500",
    badgeClass: "bg-indigo-500/10 text-indigo-600 dark:text-indigo-400",
  },
  {
    period: "2024 - 2028",
    role: "Undergraduate",
    school: "South University of Science and Technology",
    description: "Department of Computer Science and Engineering, Turing Class.",
    dotClass: "bg-sky-500 ring-sky-500",
    badgeClass: "bg-sky-500/10 text-sky-600 dark:text-sky-400",
  },
];

const researchItems = [
  {
    title: "Research Interests",
    period: "Present",
    role: "Focus Areas",
    description: "My research focuses on the theoretical foundations of learning and optimization. Current interests include: (1) spectral optimizers and optimization theory for deep neural networks; (2) theoretical analysis of genetic programming, with emphasis on generalization and runtime bounds; (3) reinforcement learning and world action models; and (4) agent systems, particularly context engineering and its underlying theory.",
    tags: ["Optimization Theory", "Genetic Programming", "Reinforcement Learning", "Agent Systems", "Context Engineering"],
  },
  {
    title: "SUSTech Theory of AI Lab",
    period: "2026",
    role: "Undergraduate Researcher",
    description: "Working on theoretical analysis of randomised search heuristics and genetic programming under the supervision of Prof. Pietro Simone Oliveto, in collaboration with Mingxuan Yin. Current work targets venues including Algorithmica, TCS, ACM TELO, and TEVC.",
    tags: ["Randomised Search Heuristics", "Genetic Programming", "Runtime Analysis"],
  },
  {
    title: "Research Internship",
    period: "2027",
    role: "Incoming Research Intern",
    description: "Seeking research internships at leading institutions in optimization, machine learning theory, and artificial intelligence.",
    tags: ["Open to opportunities"],
  },
];

const skills = [
  { name: "C++", emoji: "📜", color: "from-yellow-400 to-orange-500" },
  { name: "Java", emoji: "🔷", color: "from-blue-400 to-blue-600" },
  { name: "Python", emoji: "🐍", color: "from-cyan-400 to-blue-500" },
  { name: "C", emoji: "🟢", color: "from-green-400 to-green-600" },
  { name: "PostgreSQL", emoji: "🐘", color: "from-blue-400 to-yellow-400" },
  { name: "LaTeX", emoji: "🚀", color: "from-orange-400 to-red-500" },
  { name: "SystemVerilog", emoji: "🎨", color: "from-cyan-400 to-teal-500" },
  { name: "Git", emoji: "📦", color: "from-red-400 to-orange-500" },
];

const knowledgeGroups = [
  {
    category: "Mathematics",
    items: ["Linear Algebra", "Stochastic Processes", "Probability & Statistics", "Combinatorics", "Calculus", "Optimization", "Mathematical Logic"],
  },
  {
    category: "Computer Science",
    items: ["Data Structures and Algorithms", "Computer Networks", "Database Systems", "Theory of Computation"],
  },
  {
    category: "AI & ML",
    items: ["Machine Learning", "Deep Learning", "Reinforcement Learning"],
  },
];

const publications = [
  {
    year: "2026",
    status: "Submitted",
    statusColor: "bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/20",
    authors: "Yanqiao Chen, Dongsheng Hou, Yuhan Rui, Zhen Cao, Yepang Liu",
    venue: "NeurIPS 2026",
  },
  {
    year: "2026",
    status: "Under Review",
    statusColor: "bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/20",
    authors: "Yuhan Rui, Shihan Qiao, et al.",
    venue: "NeurIPS 2026",
  },
  {
    year: "2026",
    status: "Under Preparation",
    statusColor: "bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20",
    authors: "Dongsheng Hou, Yanqiao Chen, Yuhan Rui, et al.",
    venue: "ICLR 2027",
  },
  {
    year: "2026",
    status: "Under Preparation",
    statusColor: "bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20",
    authors: "Yanqiao Chen, Mingxuan Yin, et al.",
    venue: "Algorithmica",
  },
];

const appointments = [
  {
    period: "2025 - Present",
    role: "Vice President",
    org: "SUSTech Theoretical Computer Science Society",
    description: "Organizing lectures, workshops, and the translation of Boaz Barak's introduction to TCS.",
  },
];

const awards = [
  {
    icon: "🏆",
    year: "2025",
    title: "Star of Academic Excellence Scholarship",
    desc: "Outstanding academic performance in the 2024 academic year.",
  },
  {
    icon: "🏆",
    year: "2025",
    title: "Annual Outstanding Student Award",
    desc: "Exceptional academic achievements and contributions to the university community.",
  },
  {
    icon: "🥉",
    year: "2024",
    title: "Third Place in SUSTech Orientation Chess Tournament",
    desc: "Competed against 64 participants.",
  },
];

const courseGrades = [
  { name: "Introduction to Computer Programming", grade: "A (95/100)" },
  { name: "Data Structures and Algorithms Analysis (Honor)", grade: "A (95/100)" },
  { name: "Principles of Database (Honor)", grade: "A- (92/100)" },
  { name: "Digital Logic", grade: "A- (90/100)" },
  { name: "Computer Organization", grade: "90 (GPA 3.85)" },
  { name: "Artificial Intelligence", grade: "90 (GPA 3.85)" },
  { name: "Algorithm Design and Analysis", grade: "93 (GPA 3.94)" },
  { name: "Introduction to Theory of Computation", grade: "93 (GPA 3.94)" },
  { name: "Discrete Mathematics (Honor)", grade: "B (85/100)" },
  { name: "Introduction to Mathematical Logic", grade: "B+ (89/100)" },
  { name: "Calculus", grade: "A- (90/100)" },
  { name: "College Physics", grade: "A- (90/100)" },
];

const interests = [
  { icon: "🧮", title: "Mathematics", desc: "I maintain a broad interest in discrete mathematics, probability, and theoretical computer science, which serve as the foundation for my research." },
  { icon: "🎾", title: "Sports", desc: "Tennis and chess help me maintain focus and strategic thinking outside of research." },
  { icon: "🎵", title: "Music", desc: "Classical music and City-Pop; previously studied piano, and currently exploring electric guitar." },
];

const funFacts = [
  { label: "Location", value: "Shenzhen, Guangdong, China" },
  { label: "Favorite Algorithm", value: "Euclidean Algorithm" },
  { label: "Favorite Open Problem", value: "Karchmer-Raz-Wigderson Conjecture" },
];
---

<PageLayout title={ABOUT.TITLE} description={ABOUT.DESCRIPTION}>
  <Container>
    <div class="grid grid-cols-1 xl:grid-cols-[1fr_280px] gap-12 relative">
      <!-- Main Content -->
      <div class="space-y-20">
        <!-- Hero -->
        <section id="about-me" class="animate space-y-6">
          <div class="flex flex-col md:flex-row gap-8 items-start">
            <div class="animate animate-scale-in shrink-0">
              <div class="w-32 h-32 md:w-40 md:h-40 rounded-full bg-gradient-to-br from-blue-500 via-purple-500 to-pink-500 p-1 hover-lift overflow-hidden">
                <Image
                  src={avatarImage}
                  alt={SITE.NAME}
                  class="w-full h-full rounded-full object-cover"
                  width={160}
                  height={160}
                />
              </div>
            </div>

            <div class="flex-1 space-y-4">
              <h1 class="animate animate-delay-100 text-3xl md:text-4xl font-bold text-black dark:text-white">
                {SITE.NAME}
              </h1>

              <p class="animate animate-delay-200 text-lg text-black/60 dark:text-white/60 leading-relaxed">
                Undergraduate student in the Turing Class, Department of Computer Science and Engineering, Southern University of Science and Technology (SUSTech). My research lies at the intersection of optimization theory, machine learning, and artificial intelligence.
              </p>

              <div class="animate animate-delay-250 flex flex-wrap gap-2">
                {identityBadges.map(badge => (
                  <span class={`px-3 py-1.5 rounded-full text-sm border bg-gradient-to-r ${badge.color}`}>
                    {badge.label}
                  </span>
                ))}
              </div>

              <div class="animate animate-delay-300 flex flex-wrap gap-3 pt-2">
                <a
                  href={`mailto:${SITE.EMAIL}`}
                  class="magnetic-btn inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-black dark:bg-white text-white dark:text-black font-medium hover:scale-105 transition-transform duration-200"
                >
                  Get in Touch
                </a>
                <a
                  href="/work"
                  class="magnetic-btn inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-black/20 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 transition-colors duration-200"
                >
                  View My Work
                </a>
              </div>
            </div>
          </div>
        </section>

        <!-- About Me -->
        <section class="animate space-y-6">
          <h2 class="text-2xl font-semibold text-black dark:text-white flex items-center gap-2">
            <span class="animate-float inline-block">📖</span>
            About Me
          </h2>
          <div class="space-y-4 text-black/60 dark:text-white/60 leading-relaxed">
            <p>
              I am currently an undergraduate student in the Turing Class at SUSTech, majoring in Computer Science and Engineering. My academic background combines rigorous training in algorithms, mathematics, and machine learning, with a growing research focus on theoretical aspects of optimization and intelligent systems.
            </p>
            <p>
              I am particularly interested in understanding the theoretical foundations that underpin modern AI systems, including optimization dynamics in deep learning, the behavior of evolutionary algorithms, decision-making in reinforcement learning, and the design principles of agentic systems.
            </p>
            <p>
              Please feel free to reach out if you are interested in my research or would like to discuss related topics.
            </p>
          </div>
        </section>

        <!-- Education -->
        <section id="education" class="animate space-y-6">
          <h2 class="text-2xl font-semibold text-black dark:text-white flex items-center gap-2">
            <span class="animate-float inline-block" style="animation-delay: 0.4s;">🎓</span>
            Education
          </h2>

          <div class="relative pl-6 md:pl-8 space-y-8">
            <div class="absolute left-0 top-2 bottom-2 w-0.5 bg-gradient-to-b from-indigo-500/30 via-sky-500/30 to-transparent"></div>
            {education.map((edu, index) => (
              <div class="relative animate" style={`animation-delay: ${index * 100}ms`}>
                <div class={`absolute -left-6 md:-left-8 top-1.5 w-3 h-3 rounded-full ${edu.dotClass} ring-4 ring-white dark:ring-stone-900`}></div>
                <div class="p-5 rounded-xl border border-black/10 dark:border-white/10 hover:border-black/20 dark:hover:border-white/20 hover-lift transition-all duration-300">
                  <div class="flex flex-wrap gap-2 items-center text-sm text-black/40 dark:text-white/40 mb-2">
                    <span>{edu.period}</span>
                    <span class={`px-2 py-0.5 rounded-full ${edu.badgeClass}`}>
                      {edu.role}
                    </span>
                  </div>
                  <h3 class="font-semibold text-black dark:text-white text-lg mb-1">
                    {edu.school}
                  </h3>
                  <p class="text-black/60 dark:text-white/60">
                    {edu.description}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Research & Experience -->
        <section id="research" class="animate space-y-6">
          <h2 class="text-2xl font-semibold text-black dark:text-white flex items-center gap-2">
            <span class="animate-float inline-block" style="animation-delay: 0.47s;">🔬</span>
            Research & Experience
          </h2>

          <div class="space-y-4">
            {researchItems.map((item, index) => (
              <div
                class={`animate p-5 rounded-xl border hover-lift transition-all duration-300 ${
                  index === 0
                    ? "border-purple-500/20 bg-gradient-to-br from-purple-500/5 to-transparent hover:border-purple-500/30"
                    : "border-black/10 dark:border-white/10 hover:border-black/20 dark:hover:border-white/20"
                }`}
                style={`animation-delay: ${index * 100}ms`}
              >
                <div class="flex flex-wrap gap-2 items-center text-sm text-black/40 dark:text-white/40 mb-2">
                  <span>{item.period}</span>
                  <span class="px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/10 text-black/60 dark:text-white/60">
                    {item.role}
                  </span>
                </div>
                <h3 class="font-semibold text-black dark:text-white text-lg mb-2">
                  {item.title}
                </h3>
                <p class="text-black/60 dark:text-white/60 leading-relaxed mb-3">
                  {item.description}
                </p>
                <div class="flex flex-wrap gap-2">
                  {item.tags.map(tag => (
                    <span class="px-2 py-0.5 rounded-full text-xs bg-black/5 dark:bg-white/10 text-black/60 dark:text-white/60 border border-black/10 dark:border-white/10">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Skills & Knowledge -->
        <section id="skills" class="animate space-y-6">
          <div class="grid md:grid-cols-2 gap-8">
            <!-- Skills -->
            <div class="space-y-4">
              <h2 class="text-2xl font-semibold text-black dark:text-white flex items-center gap-2">
                <span class="animate-float inline-block" style="animation-delay: 0.5s;">🛠️</span>
                Skills
              </h2>
              <div class="grid grid-cols-2 gap-3">
                {skills.map((skill, index) => (
                  <div
                    class="animate p-3 rounded-xl border border-black/10 dark:border-white/10 hover:border-black/20 dark:hover:border-white/20 hover-lift transition-all duration-300"
                    style={`animation-delay: ${index * 50}ms`}
                  >
                    <div class={`w-8 h-8 rounded-lg bg-gradient-to-br ${skill.color} flex items-center justify-center text-base mb-2`}>
                      {skill.emoji}
                    </div>
                    <h3 class="font-medium text-black dark:text-white text-sm">
                      {skill.name}
                    </h3>
                  </div>
                ))}
              </div>
            </div>

            <!-- Knowledge -->
            <div class="space-y-4">
              <h2 class="text-2xl font-semibold text-black dark:text-white flex items-center gap-2">
                <span class="animate-float inline-block" style="animation-delay: 0.6s;">📚</span>
                Knowledge
              </h2>
              <div class="space-y-4">
                {knowledgeGroups.map((group, gIndex) => (
                  <div class="animate" style={`animation-delay: ${gIndex * 100}ms`}>
                    <div class="text-sm font-medium text-black/50 dark:text-white/50 mb-2">
                      {group.category}
                    </div>
                    <div class="flex flex-wrap gap-2">
                      {group.items.map((item, index) => (
                        <span
                          class="px-3 py-1 rounded-lg text-sm border border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5 text-black/70 dark:text-white/70 hover:bg-black/10 dark:hover:bg-white/10 transition-colors"
                          style={`animation-delay: ${index * 30}ms`}
                        >
                          {item}
                        </span>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>

        <!-- Publications & Appointments -->
        <section id="publications" class="animate space-y-6">
          <div class="grid md:grid-cols-2 gap-8">
            <!-- Publications -->
            <div class="space-y-4">
              <h2 class="text-2xl font-semibold text-black dark:text-white flex items-center gap-2">
                <span class="animate-float inline-block" style="animation-delay: 1.2s;">📚</span>
                Publications
              </h2>
              <div class="space-y-3">
                {publications.map((pub, index) => (
                  <div
                    class="animate p-4 rounded-xl border border-black/10 dark:border-white/10 hover:border-black/20 dark:hover:border-white/20 hover-lift transition-all duration-300"
                    style={`animation-delay: ${index * 100}ms`}
                  >
                    <div class="flex flex-wrap items-center gap-2 mb-2">
                      <span class="text-sm text-black/40 dark:text-white/40">{pub.year}</span>
                      <span class={`px-2 py-0.5 rounded-full text-xs border ${pub.statusColor}`}>
                        {pub.status}
                      </span>
                    </div>
                    <p class="text-sm text-black/70 dark:text-white/70 mb-1">
                      {pub.authors}
                    </p>
                    <p class="text-sm text-black/40 dark:text-white/40">
                      {pub.venue}
                    </p>
                  </div>
                ))}
              </div>
            </div>

            <!-- Appointments -->
            <div class="space-y-4">
              <h2 class="text-2xl font-semibold text-black dark:text-white flex items-center gap-2">
                <span class="animate-float inline-block" style="animation-delay: 1.3s;">🏛️</span>
                Appointments
              </h2>
              <div class="space-y-3">
                {appointments.map((app, index) => (
                  <div
                    class="animate p-4 rounded-xl border border-black/10 dark:border-white/10 hover:border-black/20 dark:hover:border-white/20 hover-lift transition-all duration-300"
                    style={`animation-delay: ${index * 100}ms`}
                  >
                    <div class="text-sm text-black/40 dark:text-white/40 mb-1">
                      {app.period}
                    </div>
                    <h3 class="font-medium text-black dark:text-white mb-1">
                      {app.role}
                    </h3>
                    <p class="text-sm text-black/60 dark:text-white/60 mb-2">
                      {app.org}
                    </p>
                    <p class="text-sm text-black/50 dark:text-white/50">
                      {app.description}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>

        <!-- Honors & Awards -->
        <section id="awards" class="animate space-y-6">
          <h2 class="text-2xl font-semibold text-black dark:text-white flex items-center gap-2">
            <span class="animate-float inline-block" style="animation-delay: 2.1s;">🏆</span>
            Honors & Awards
          </h2>

          <div class="grid md:grid-cols-2 gap-4">
            <!-- GPA Featured -->
            <div class="animate md:col-span-2 p-6 rounded-2xl border border-yellow-500/20 bg-gradient-to-br from-yellow-500/10 to-transparent hover:border-yellow-500/30 hover-lift transition-all">
              <div class="flex flex-col md:flex-row md:items-center gap-6">
                <div class="text-5xl">📊</div>
                <div class="flex-1">
                  <div class="text-sm text-black/50 dark:text-white/50 mb-1">Cumulative GPA</div>
                  <h3 class="text-3xl font-bold text-black dark:text-white mb-2">3.83 / 4.0</h3>
                  <div class="grid grid-cols-2 md:grid-cols-4 gap-2 text-sm text-black/60 dark:text-white/60">
                    <span>Fall 2024: 3.72</span>
                    <span>Spring 2024: 3.91</span>
                    <span>Fall 2025: 3.85</span>
                    <span>Spring 2026: 3.83</span>
                  </div>
                </div>
              </div>
            </div>

            {awards.map((award, index) => (
              <div
                class="animate p-5 rounded-xl border border-yellow-500/20 bg-gradient-to-br from-yellow-500/5 to-transparent hover:border-yellow-500/30 hover-lift transition-all"
                style={`animation-delay: ${(index + 1) * 100}ms`}
              >
                <div class="flex items-start gap-4">
                  <div class="text-3xl">{award.icon}</div>
                  <div class="flex-1">
                    <div class="text-sm text-black/40 dark:text-white/40 mb-1">{award.year}</div>
                    <h3 class="font-semibold text-black dark:text-white mb-1">{award.title}</h3>
                    <p class="text-sm text-black/50 dark:text-white/50">{award.desc}</p>
                  </div>
                </div>
              </div>
            ))}

            <!-- English Proficiency -->
            <div class="animate md:col-span-2 p-5 rounded-xl border border-black/10 dark:border-white/10 hover:border-black/20 dark:hover:border-white/20 hover-lift transition-all">
              <div class="flex items-start gap-4">
                <div class="text-3xl">🌐</div>
                <div class="flex-1 min-w-0">
                  <div class="text-sm text-black/50 dark:text-white/50 mb-2">English Proficiency</div>
                  <div class="grid md:grid-cols-2 gap-4">
                    <div>
                      <h3 class="font-semibold text-black dark:text-white mb-2 text-sm">Standardized Tests</h3>
                      <ul class="text-sm text-black/60 dark:text-white/60 space-y-1">
                        <li>• CET-4: <span class="font-medium text-black dark:text-white">620/710</span></li>
                        <li>• CET-6: <span class="font-medium text-black dark:text-white">624/710</span></li>
                        <li>• TOEFL: <span class="font-medium text-black dark:text-white">To be taken in 2026</span></li>
                      </ul>
                    </div>
                    <div>
                      <h3 class="font-semibold text-black dark:text-white mb-2 text-sm">Academic Courses</h3>
                      <ul class="text-sm text-black/60 dark:text-white/60 space-y-1">
                        <li>• SUSTech English II: <span class="font-medium text-green-600 dark:text-green-400">A (96/100)</span></li>
                        <li>• SUSTech English III: <span class="font-medium text-green-600 dark:text-green-400">A+ (97/100)</span></li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Key Course Grades -->
            <div class="animate md:col-span-2 p-5 rounded-xl border border-black/10 dark:border-white/10 hover:border-black/20 dark:hover:border-white/20 hover-lift transition-all">
              <div class="flex items-start gap-4">
                <div class="text-3xl">🎓</div>
                <div class="flex-1">
                  <div class="text-sm text-black/50 dark:text-white/50 mb-2">Key Course Grades</div>
                  <div class="grid md:grid-cols-2 gap-x-6 gap-y-1 text-sm text-black/60 dark:text-white/60">
                    {courseGrades.map(course => (
                      <div class="flex justify-between py-1 border-b border-black/5 dark:border-white/5">
                        <span>{course.name}</span>
                        <span class="font-medium text-black dark:text-white">{course.grade}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Interests -->
        <section id="interests" class="animate space-y-6">
          <h2 class="text-2xl font-semibold text-black dark:text-white flex items-center gap-2">
            <span class="animate-float inline-block" style="animation-delay: 1s;">✨</span>
            Interests
          </h2>

          <div class="grid md:grid-cols-3 gap-4">
            {interests.map((item, index) => (
              <div
                class="animate p-5 rounded-2xl border border-black/10 dark:border-white/10 bg-gradient-to-br from-transparent to-black/5 dark:to-white/5 hover-lift transition-all"
                style={`animation-delay: ${index * 100}ms`}
              >
                <div class="text-3xl mb-3">{item.icon}</div>
                <h3 class="font-semibold text-black dark:text-white mb-2">{item.title}</h3>
                <p class="text-sm text-black/50 dark:text-white/50">{item.desc}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Contact -->
        <section id="contact" class="animate space-y-6">
          <h2 class="text-2xl font-semibold text-black dark:text-white flex items-center gap-2">
            <span class="animate-float inline-block" style="animation-delay: 1.5s;">🤝</span>
            Contact Me
          </h2>

          <div class="p-6 rounded-2xl border border-black/10 dark:border-white/10 bg-gradient-to-br from-transparent to-black/5 dark:to-white/5">
            <p class="text-lg mb-6 text-black/60 dark:text-white/60">
              I welcome discussions on research collaborations, academic opportunities, and related topics. Please reach out via email or any of the platforms below.
            </p>

            <div class="flex flex-wrap gap-3">
              {SOCIALS.map((SOCIAL) => (
                <a
                  href={SOCIAL.HREF}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="magnetic-btn inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-black/5 dark:bg-white/10 hover:bg-black/10 dark:hover:bg-white/20 transition-colors duration-200 capitalize"
                >
                  {SOCIAL.NAME}
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3" />
                  </svg>
                </a>
              ))}
              <a
                href={`mailto:${SITE.EMAIL}`}
                class="magnetic-btn inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-black dark:bg-white text-white dark:text-black hover:opacity-80 transition-opacity duration-200"
              >
                Email
                <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                  <polyline points="22,6 12,13 2,6" />
                </svg>
              </a>
            </div>
          </div>
        </section>

        <!-- Fun Facts -->
        <section id="fun-facts" class="animate space-y-6">
          <h2 class="text-2xl font-semibold text-black dark:text-white flex items-center gap-2">
            <span class="animate-float inline-block" style="animation-delay: 2s;">🎯</span>
            Quick Facts
          </h2>

          <div class="flex flex-wrap gap-3">
            {funFacts.map((fact, index) => (
              <div
                class="animate px-4 py-2 rounded-full border border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5"
                style={`animation-delay: ${index * 100}ms`}
              >
                <span class="text-sm text-black/50 dark:text-white/50">{fact.label}:</span>
                <span class="text-sm font-medium text-black dark:text-white ml-1">{fact.value}</span>
              </div>
            ))}
          </div>
        </section>
      </div>

      <!-- Sidebar -->
      <aside class="hidden xl:block">
        <div class="sticky top-24 space-y-6 pb-8">
          <!-- Mini Profile -->
          <div class="p-5 rounded-xl border border-black/10 dark:border-white/10 bg-gradient-to-br from-black/5 dark:from-white/5 to-transparent">
            <div class="flex items-center gap-4 mb-4">
              <Image
                src={avatarImage}
                alt={SITE.NAME}
                class="w-14 h-14 rounded-full object-cover border border-white dark:border-stone-800"
                width={56}
                height={56}
              />
              <div>
                <h3 class="font-bold text-black dark:text-white">{SITE.NAME}</h3>
                <p class="text-xs text-black/50 dark:text-white/50">Turing Class @ SUSTech</p>
              </div>
            </div>
            <a
              href={`mailto:${SITE.EMAIL}`}
              class="block w-full text-center py-2 rounded-lg bg-black dark:bg-white text-white dark:text-black font-medium hover:opacity-80 transition-opacity"
            >
              Contact Me
            </a>
          </div>

          <!-- Section Nav -->
          <nav class="p-4 rounded-xl border border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5">
            <h3 class="text-sm font-semibold text-black dark:text-white mb-3 px-2">On this page</h3>
            <ul class="space-y-1" id="about-nav">
              {sections.map(section => (
                <li>
                  <a
                    href={`#${section.id}`}
                    class="about-nav-link block px-2 py-1.5 text-sm rounded-lg text-black/60 dark:text-white/60 hover:bg-black/5 dark:hover:bg-white/5 hover:text-black dark:hover:text-white transition-colors"
                    data-target={section.id}
                  >
                    {section.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </aside>
    </div>
  </Container>

  <script>
    // Scroll reveal animation
    const observerOptions = {
      root: null,
      rootMargin: "0px",
      threshold: 0.1,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("show");
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.addEventListener("DOMContentLoaded", () => {
      const animateElements = document.querySelectorAll(".animate");
      animateElements.forEach((el) => observer.observe(el));
    });

    // Section nav scroll spy
    const navLinks = document.querySelectorAll(".about-nav-link");
    const sections = Array.from(navLinks).map((link) =>
      document.getElementById(link.getAttribute("data-target") || "")
    ).filter(Boolean);

    const spyObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            navLinks.forEach((link) => {
              link.classList.remove("bg-black/10", "dark:bg-white/10", "text-black", "dark:text-white", "font-medium");
              if (link.getAttribute("data-target") === entry.target.id) {
                link.classList.add("bg-black/10", "dark:bg-white/10", "text-black", "dark:text-white", "font-medium");
              }
            });
          }
        });
      },
      { rootMargin: "-20% 0px -60% 0px", threshold: 0 }
    );

    sections.forEach((section) => spyObserver.observe(section));

    // Magnetic button effect
    document.querySelectorAll(".magnetic-btn").forEach((btn) => {
      btn.addEventListener("mousemove", (e) => {
        const rect = (e.currentTarget as HTMLElement).getBoundingClientRect();
        const x = (e as MouseEvent).clientX - rect.left - rect.width / 2;
        const y = (e as MouseEvent).clientY - rect.top - rect.height / 2;
        (e.currentTarget as HTMLElement).style.transform = `translate(${x * 0.1}px, ${y * 0.1}px)`;
      });

      btn.addEventListener("mouseleave", (e) => {
        (e.currentTarget as HTMLElement).style.transform = "translate(0, 0)";
      });
    });
  </script>
</PageLayout>
