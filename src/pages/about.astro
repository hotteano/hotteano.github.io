  { name: "Introduction to Theory of Computation", grade: "A (93/100)" },
  { name: "Discrete Mathematics (Honor)", grade: "B (85/100)" },
  { name: "Introduction to Mathematical Logic", grade: "B+ (89/100)" },
  { name: "Calculus", grade: "A- (90/100)" },
  { name: "College Physics", grade: "A- (90/100)" },
