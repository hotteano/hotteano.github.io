  { name: "Java", emoji: "🔷", color: "from-blue-400 to-blue-600" },
  { name: "Python", emoji: "🐍", color: "from-cyan-400 to-blue-500" },
  { name: "C", emoji: "🟢", color: "from-green-400 to-green-600" },
  { name: "PostgreSQL", emoji: "🐘", color: "from-blue-400 to-yellow-400" },
  { name: "LaTeX", emoji: "🚀", color: "from-orange-400 to-red-500" },
  { name: "SystemVerilog", emoji: "🎨", color: "from-cyan-400 to-teal-500" },
  { name: "Git", emoji: "📦", color: "from-red-400 to-orange-500" },
];

const knowledgeGroups = [
  {
    category: "Mathematics",
    items: [
      "Linear Algebra",
      "Stochastic Processes",
      "Probability & Statistics",
      "Combinatorics",
      "Calculus",
      "Optimization",
      "Mathematical Logic",
    ],
  },
