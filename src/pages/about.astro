          </div>
        </section>

        <!-- Contact -->
        <section id="contact" class="animate space-y-6">
          <h2
            class="section-title flex items-center gap-2"
          >
            <span
              class="animate-float inline-block"
              style="animation-delay: 1.5s;">🤝</span
            >
            Contact Me
          </h2>

          <GlassCard padding="p-6">
            <p class="text-lg mb-6 text-black/60 dark:text-white/60">
              I welcome discussions on research collaborations, academic
              opportunities, and related topics. Please reach out via email or
              any of the platforms below.
            </p>

            <div class="flex flex-wrap gap-3">
              {
                SOCIALS.map((SOCIAL) => (
                  <a
                    href={SOCIAL.HREF}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-glass magnetic-btn capitalize"
                  >
                    {SOCIAL.NAME}
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="size-3"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3" />
                    </svg>
                  </a>
                ))
              }
              <a
                href={`mailto:${SITE.EMAIL}`}
                class="btn-glass-primary magnetic-btn"
              >
                Email
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="size-3"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                  ></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </a>
            </div>
          </GlassCard>
        </section>

        <!-- Fun Facts -->
        <section id="fun-facts" class="animate space-y-6">
          <h2
            class="section-title flex items-center gap-2"
          >
            <span
              class="animate-float inline-block"
              style="animation-delay: 2s;">🎯</span
            >
            Quick Facts
          </h2>

          <div class="flex flex-wrap gap-3">
            {
              funFacts.map((fact, index) => (
                <div
                  class="animate badge-tech"
                  style={`animation-delay: ${index * 100}ms`}
                >
                  <span class="text-black/50 dark:text-white/50">
