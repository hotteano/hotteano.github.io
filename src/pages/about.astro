const interests = [
  {
    icon: "🧮",
    title: "Mathematics",
    desc: "I maintain a broad interest in discrete mathematics, probability, and theoretical computer science, which serve as the foundation for my research.",
  },
  {
    icon: "🎾",
    title: "Sports",
    desc: "Tennis and chess help me maintain focus and strategic thinking outside of research.",
  },
  {
    icon: "🎵",
    title: "Music",
    desc: "Classical music and City-Pop; previously studied piano, and currently exploring electric guitar.",
  },
