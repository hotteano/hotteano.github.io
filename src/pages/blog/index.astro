---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard.astro";
import GlassCard from "@components/GlassCard.astro";
import { BLOG } from "@consts";

const data = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

type ColumnPosts = {
  [column: string]: CollectionEntry<"blog">[];
};

type YearData = {
  columns: ColumnPosts;
  uncategorized: CollectionEntry<"blog">[];
};

type Acc = {
  [year: string]: YearData;
};

const quickLinks = [
  { label: "专栏", href: "/blog/columns" },
  { label: "学习路线", href: "/blog/cs-fundamentals" },
  { label: "标签", href: "/blog/tags" },
  { label: "归档", href: "/blog/archive" },
];

const posts = data.reduce((acc: Acc, post) => {
    const year = post.data.date.getFullYear().toString();
    if (!acc[year]) {
      acc[year] = { columns: {}, uncategorized: [] };
    }

    const column = post.data.column;
    if (column) {
      if (!acc[year].columns[column]) {
        acc[year].columns[column] = [];
      }
      acc[year].columns[column].push(post);
    } else {
      acc[year].uncategorized.push(post);
    }

    return acc;
  }, {});

const years = Object.keys(posts).sort((a, b) => parseInt(b) - parseInt(a));

const allColumns = [...new Set(data.map(post => post.data.column).filter(Boolean))] as string[];

const columnColors: Record<string, string> = {
  "学习笔记": "from-blue-500/20 to-cyan-500/20 border-blue-500/30 text-blue-700 dark:text-blue-300",
  "期末复习": "from-rose-500/20 to-red-500/20 border-rose-500/30 text-rose-700 dark:text-rose-300",
  "投资": "from-amber-500/20 to-orange-500/20 border-amber-500/30 text-amber-700 dark:text-amber-300",
  "读书笔记": "from-emerald-500/20 to-green-500/20 border-emerald-500/30 text-emerald-700 dark:text-emerald-300",
  "说明": "from-purple-500/20 to-pink-500/20 border-purple-500/30 text-purple-700 dark:text-purple-300",
};
---

<PageLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="animate space-y-2">
        <div class="text-sm text-black/50 dark:text-white/50">Writing</div>
        <h1 class="section-title">Blog</h1>
        <p class="text-black/65 dark:text-white/75 max-w-2xl">
          Notes, reviews, and write-ups on computer science, mathematics, and research.
        </p>
      </div>

      {/* Quick nav */}
      <GlassCard glow padding="p-4" class="animate">
        <div class="flex flex-wrap gap-3 items-center">
          <div class="text-sm text-black/50 dark:text-white/50">浏览方式</div>
          <div class="flex flex-wrap gap-2">
            {allColumns.map(column => (
              <a
                href={`/blog/column/${encodeURIComponent(column)}`}
                class={`px-3 py-1.5 text-sm rounded-full border bg-gradient-to-r ${columnColors[column] || "from-gray-500/20 to-slate-500/20 border-gray-500/30"} hover:scale-105 transition-transform`}
              >
                {column}
              </a>
            ))}
            {quickLinks.map(link => (
              <a
                href={link.href}
                class="px-3 py-1.5 text-sm rounded-full border border-white/20 dark:border-white/10 bg-white/10 dark:bg-white/5 text-black/70 dark:text-white/70 hover:bg-white/15 dark:hover:bg-white/10 transition-colors"
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>
      </GlassCard>

      <div class="space-y-8">
        {years.map(year => {
          const yearData = posts[year];
          const hasColumns = Object.keys(yearData.columns).length > 0;
          const hasUncategorized = yearData.uncategorized.length > 0;

          return (
            <GlassCard class="animate space-y-6" padding="p-6 md:p-8">
              <div class="font-semibold text-2xl text-black dark:text-white border-b border-black/10 dark:border-white/10 pb-3 flex items-center gap-3">
                <span>{year}</span>
                <span class="text-sm font-normal text-black/40 dark:text-white/40">
                  {Object.values(yearData.columns).flat().length + yearData.uncategorized.length} posts
                </span>
              </div>

              <div class="space-y-6">
                {hasColumns && (
                  <div class="space-y-5">
                    {Object.entries(yearData.columns).map(([column, columnPosts]) => (
                      <div class="space-y-3">
                        <div class="flex items-center gap-2">
                          <span class={`px-3 py-1 text-xs rounded-full border bg-gradient-to-r ${columnColors[column] || "from-gray-500/20 to-slate-500/20 border-gray-500/30"}`}>
                            {column}
                          </span>
                        </div>
                        <ul class="flex flex-col gap-3 pl-4 border-l-2 border-blue-200/50 dark:border-blue-800/50">
                          {columnPosts.map((post) => (
                            <li>
                              <ArrowCard entry={post}/>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                )}

                {hasUncategorized && (
                  <div class="space-y-3">
                    {hasColumns && (
                      <div class="flex items-center gap-2">
                        <span class="px-3 py-1 text-xs rounded-full border border-white/20 dark:border-white/10 bg-white/10 dark:bg-white/5 text-black/60 dark:text-white/60">
                          其他
                        </span>
                      </div>
                    )}
                    <ul class={`flex flex-col gap-3 ${hasColumns ? 'pl-4 border-l-2 border-gray-200/50 dark:border-gray-800/50' : ''}`}>
                      {yearData.uncategorized.map((post) => (
                        <li>
                          <ArrowCard entry={post}/>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </GlassCard>
          );
        })}
      </div>
    </div>
  </Container>
</PageLayout>
