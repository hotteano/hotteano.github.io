---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard.astro";
import GlassCard from "@components/GlassCard.astro";
import { BLOG } from "@consts";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const columns = [...new Set(posts.map(post => post.data.column).filter(Boolean))];

  return columns.map(column => ({
    params: { column },
    props: { column },
  }));
}

interface Props {
  column: string;
}

const { column } = Astro.props;

const data = (await getCollection("blog"))
  .filter(post => !post.data.draft && post.data.column === column)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

type Acc = {
  [year: string]: CollectionEntry<"blog">[];
}

const posts = data.reduce((acc: Acc, post) => {
    const year = post.data.date.getFullYear().toString();
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(post);
    return acc;
  }, {});

const years = Object.keys(posts).sort((a, b) => parseInt(b) - parseInt(a));

const allPosts = await getCollection("blog");
const allColumns = [...new Set(allPosts.map(post => post.data.column).filter(Boolean))] as string[];

const columnColors: Record<string, string> = {
  "学习笔记": "from-blue-500/20 to-cyan-500/20 border-blue-500/30 text-blue-700 dark:text-blue-300",
  "期末复习": "from-rose-500/20 to-red-500/20 border-rose-500/30 text-rose-700 dark:text-rose-300",
  "投资": "from-amber-500/20 to-orange-500/20 border-amber-500/30 text-amber-700 dark:text-amber-300",
  "读书笔记": "from-emerald-500/20 to-green-500/20 border-emerald-500/30 text-emerald-700 dark:text-emerald-300",
  "说明": "from-purple-500/20 to-pink-500/20 border-purple-500/30 text-purple-700 dark:text-purple-300",
};
---

<PageLayout title={`${column} | ${BLOG.TITLE}`} description={`${column}专栏文章`}>
  <Container>
    <div class="space-y-10">
      <div class="animate space-y-4">
        <div class="flex items-center gap-2 text-sm text-black/50 dark:text-white/50">
          <a href="/blog" class="hover:text-black dark:hover:text-white transition-colors">Blog</a>
          <span>/</span>
          <a href="/blog/columns" class="hover:text-black dark:hover:text-white transition-colors">专栏</a>
        </div>
        <div class="flex items-center gap-3">
          <span class={`px-4 py-1.5 rounded-full text-lg font-semibold border bg-gradient-to-r ${columnColors[column] || "from-gray-500/20 to-slate-500/20 border-gray-500/30"} backdrop-blur-sm`}>
            {column}
          </span>
          <span class="text-black/50 dark:text-white/50 text-sm">
            {data.length} 篇文章
          </span>
        </div>
      </div>

      {allColumns.length > 1 && (
        <GlassCard glow padding="p-4" class="animate">
          <div class="flex flex-wrap gap-3 items-center">
            <div class="text-sm text-black/50 dark:text-white/50">其他专栏</div>
            <div class="flex flex-wrap gap-2">
              {allColumns.filter(c => c !== column).map(otherColumn => (
                <a
                  href={`/blog/column/${encodeURIComponent(otherColumn)}`}
                  class={`px-3 py-1.5 text-sm rounded-full border bg-gradient-to-r ${columnColors[otherColumn] || "from-gray-500/20 to-slate-500/20 border-gray-500/30"} hover:scale-105 transition-transform`}
                >
                  {otherColumn}
                </a>
              ))}
            </div>
          </div>
        </GlassCard>
      )}

      <div class="space-y-6">
        {years.map(year => (
          <GlassCard class="animate space-y-4" padding="p-6 md:p-8">
            <div class="font-semibold text-xl text-black dark:text-white border-b border-black/10 dark:border-white/10 pb-2">
              {year}
            </div>
            <ul class="flex flex-col gap-3">
              {posts[year].map((post) => (
                <li>
                  <ArrowCard entry={post}/>
                </li>
              ))}
            </ul>
          </GlassCard>
        ))}
      </div>

      {data.length === 0 && (
        <div class="animate text-black/50 dark:text-white/50">
          该专栏下暂无文章。
        </div>
      )}
    </div>
  </Container>
</PageLayout>
