---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard.astro";
import { BLOG } from "@consts";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const columns = [...new Set(posts.map(post => post.data.column).filter(Boolean))];
  
  return columns.map(column => ({
    params: { column },
    props: { column },
  }));
}

interface Props {
  column: string;
}

const { column } = Astro.props;

const data = (await getCollection("blog"))
  .filter(post => !post.data.draft && post.data.column === column)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

type Acc = {
  [year: string]: CollectionEntry<"blog">[];
}

const posts = data.reduce((acc: Acc, post) => {
    const year = post.data.date.getFullYear().toString();
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(post);
    return acc;
  }, {});

const years = Object.keys(posts).sort((a, b) => parseInt(b) - parseInt(a));

// 获取所有专栏用于导航
const allPosts = await getCollection("blog");
const allColumns = [...new Set(allPosts.map(post => post.data.column).filter(Boolean))] as string[];
---

<PageLayout title={`${column} | ${BLOG.TITLE}`} description={`${column}专栏文章`}>
  <Container>
    <div class="space-y-10">
      <div class="animate space-y-4">
        <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
          <a href="/blog" class="hover:text-gray-700 dark:hover:text-gray-300 transition-colors">Blog</a>
          <span>/</span>
          <span>专栏</span>
        </div>
        <div class="font-semibold text-2xl text-black dark:text-white">
          {column}
        </div>
      </div>
      
      {/* 专栏导航 */}
      {allColumns.length > 1 && (
        <div class="animate space-y-3">
          <div class="text-sm text-gray-500 dark:text-gray-400">其他专栏</div>
          <div class="flex flex-wrap gap-2">
            {allColumns.filter(c => c !== column).map(otherColumn => (
              <a
                href={`/blog/column/${encodeURIComponent(otherColumn)}`}
                class="px-3 py-1.5 text-sm rounded-full bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
              >
                {otherColumn}
              </a>
            ))}
          </div>
        </div>
      )}
      
      <div class="space-y-8">
        {years.map(year => (
          <section class="animate space-y-4">
            <div class="font-semibold text-xl text-black dark:text-white border-b border-gray-200 dark:border-gray-800 pb-2">
              {year}
            </div>
            <div>
              <ul class="flex flex-col gap-4">
                {posts[year].map((post) => (
                  <li>
                    <ArrowCard entry={post}/>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        ))}
      </div>
      
      {data.length === 0 && (
        <div class="animate text-gray-500 dark:text-gray-400">
          该专栏下暂无文章。
        </div>
      )}
    </div>
  </Container>
</PageLayout>
