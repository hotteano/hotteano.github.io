---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
}

const { href, external, underline = true, ...rest } = Astro.props;
---

<a 
  href={href} 
  target={ external ? "_blank" : "_self" } 
  class={cn(
    "inline-block text-current hover:text-black hover:dark:text-white transition-colors duration-300 ease-in-out",
    underline && "underline underline-offset-4 decoration-black/20 dark:decoration-white/30 hover:decoration-blue-500/60 dark:hover:decoration-blue-400/60 decoration-2"
  )}
  {...rest}>
  <slot/>
</a>
