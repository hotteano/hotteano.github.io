---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@components/FormattedDate.astro";

interface Props {
  column: string;
  description: string;
  posts: CollectionEntry<"blog">[];
  icon: string;
  color: string;
}

const { column, description, posts, icon, color } = Astro.props;
const latestPosts = posts.slice(0, 3);
---

<a
  href={`/blog/column/${encodeURIComponent(column)}`}
  class="group relative block p-6 rounded-2xl border border-white/20 dark:border-white/10 bg-white/10 dark:bg-white/5 backdrop-blur-xl overflow-hidden hover-lift transition-all duration-300 shadow-lg hover:shadow-xl"
>
  <!-- Animated gradient orb -->
  <div
    class={`absolute top-0 right-0 w-40 h-40 bg-gradient-to-br ${color} opacity-15 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 group-hover:opacity-30 group-hover:scale-110 transition-all duration-500`}
  >
  </div>

  <!-- Shine effect -->
  <div
    class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
    style="background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.08) 45%, rgba(255,255,255,0.15) 50%, rgba(255,255,255,0.08) 55%, transparent 60%); transform: translateX(-100%); animation: column-shine 4s ease-in-out infinite;"
  >
  </div>

  <div class="relative z-10">
    <div class="flex items-start justify-between mb-4">
      <div class="flex items-center gap-3">
        <span class="text-3xl group-hover:scale-110 transition-transform duration-300">{icon}</span>
        <div>
          <h3 class="text-xl font-bold text-black dark:text-white group-hover:text-black/80 dark:group-hover:text-white/80 transition-colors">
            {column}
          </h3>
          <p class="text-sm text-black/50 dark:text-white/50">
            {posts.length} 篇文章
          </p>
        </div>
      </div>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="size-5 text-black/30 dark:text-white/30 group-hover:translate-x-1 group-hover:text-black/60 dark:group-hover:text-white/60 transition-all duration-300"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M5 12h14M12 5l7 7-7 7"></path>
      </svg>
    </div>

    <p class="text-sm text-black/75 dark:text-white/80 mb-5 leading-relaxed">
      {description}
    </p>

    {latestPosts.length > 0 && (
      <div class="space-y-3">
        <div class="text-xs font-medium text-black/40 dark:text-white/40 uppercase tracking-wider">
          Latest
        </div>
        <ul class="space-y-2">
          {latestPosts.map((post) => (
            <li class="flex items-center gap-3 text-sm">
              <span class="text-black/40 dark:text-white/40 text-xs shrink-0">
                <FormattedDate date={post.data.date} />
              </span>
              <span class="text-black/70 dark:text-white/70 truncate group-hover:text-black dark:group-hover:text-white transition-colors">
                {post.data.title}
              </span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</a>

<style>
  @keyframes column-shine {
    0% { transform: translateX(-100%); }
    30%, 100% { transform: translateX(100%); }
  }
</style>
