---
type Props = {
  href: string;
}

const { href } = Astro.props;
---

<a href={href} class="group relative w-fit flex items-center gap-2 pl-9 pr-4 py-2 rounded-full border border-white/20 dark:border-white/10 bg-white/10 dark:bg-white/5 backdrop-blur-md text-black/70 dark:text-white/75 hover:bg-white/20 dark:hover:bg-white/10 hover:text-black dark:hover:text-white hover:scale-105 transition-all duration-300 ease-out">
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    viewBox="0 0 24 24"
    class="absolute left-3 top-1/2 -translate-y-1/2 size-4 stroke-2 fill-none stroke-current transition-transform duration-300 group-hover:-translate-x-1">
    <line x1="5" y1="12" x2="19" y2="12" class="translate-x-2 group-hover:translate-x-0 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-in-out" />
    <polyline points="12 5 5 12 12 19" class="translate-x-1 group-hover:translate-x-0 transition-transform duration-300 ease-in-out" />
  </svg>
  <span class="text-sm font-medium">
    <slot/>
  </span>
</a>
