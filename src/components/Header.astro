---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";

const navItems = [
  { label: "Blogs", href: "/blog" },
  { label: "Work", href: "/work" },
  { label: "Projects", href: "/projects" },
  { label: "About", href: "/about" },
];
---

<header id="main-header">
  <Container>
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <Link href="/" underline={false}>
        <div class="font-semibold text-lg flex items-center gap-2 group">
          <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-black/5 dark:bg-white/10 text-black/80 dark:text-white/80 transition-transform duration-300 group-hover:rotate-12 group-hover:scale-105">
            ✦
          </span>
          <span class="bg-clip-text text-transparent bg-gradient-to-r from-black to-black/70 dark:from-white dark:to-white/70 hidden sm:block">
            {SITE.NAME}
          </span>
        </div>
      </Link>

      <!-- Apple-style floating pill nav -->
      <div class="flex items-center gap-3">
        <nav
          class="flex items-center gap-1 px-2 py-1.5 rounded-full border border-white/25 dark:border-white/10 bg-white/65 dark:bg-black/40 backdrop-blur-xl shadow-[0_8px_32px_-12px_rgba(0,0,0,0.15)] dark:shadow-[0_8px_32px_-12px_rgba(0,0,0,0.4)] transition-all duration-300"
          id="main-nav"
        >
          {navItems.map((item) => (
            <a
              href={item.href}
              data-nav-link
              class="nav-link relative px-4 py-1.5 rounded-full text-sm font-medium text-black/65 dark:text-white/70 hover:text-black dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/10 transition-all duration-200"
            >
              {item.label}
            </a>
          ))}
        </nav>

        <!-- Theme Toggle -->
        <button
          id="theme-toggle"
          class="group flex items-center justify-center w-9 h-9 rounded-full border border-white/25 dark:border-white/10 bg-white/65 dark:bg-black/40 backdrop-blur-xl shadow-[0_8px_32px_-12px_rgba(0,0,0,0.15)] dark:shadow-[0_8px_32px_-12px_rgba(0,0,0,0.4)] text-black/65 dark:text-white/70 hover:text-black dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/10 hover:scale-105 transition-all duration-200"
          aria-label="Toggle theme"
        >
          <svg id="sun-icon" xmlns="http://www.w3.org/2000/svg" class="size-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <svg id="moon-icon" xmlns="http://www.w3.org/2000/svg" class="size-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
      </div>
    </div>
  </Container>
</header>

<script>
  // Theme toggle functionality
  const themeToggle = document.getElementById('theme-toggle');
  const html = document.documentElement;

  // Check for saved theme preference or default to 'light'
  const currentTheme = localStorage.getItem('theme') || 'light';
  html.classList.toggle('dark', currentTheme === 'dark');

  themeToggle?.addEventListener('click', () => {
    html.classList.toggle('dark');
    const isDark = html.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // Active nav indicator
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const pathname = window.location.pathname;

  navLinks.forEach(link => {
    const href = link.getAttribute('href') || '';
    const isActive = href === '/' ? pathname === '/' : pathname.startsWith(href);
    if (isActive) {
      link.classList.add('active');
    }
  });
</script>

<style>
  .nav-link.active {
    @apply bg-white dark:bg-white/15 text-black dark:text-white shadow-sm;
  }
</style>
