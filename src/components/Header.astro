---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";
---

<header id="main-header">
  <Container>
    <div class="flex flex-wrap gap-y-2 justify-between items-center">
      <Link href="/" underline={false}>
        <div class="font-semibold text-lg flex items-center gap-2 group">
          <span class="inline-block transition-transform duration-300 group-hover:rotate-12">✦</span>
          <span class="bg-clip-text text-transparent bg-gradient-to-r from-black to-black/70 dark:from-white dark:to-white/70">
            {SITE.NAME}
          </span>
        </div>
      </Link>
      
      <div class="flex items-center gap-4">
        <nav class="flex gap-1 items-center">
          <Link href="/blog" class="nav-link relative px-3 py-1.5 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors duration-200">
            <span class="relative z-10">Blogs</span>
          </Link>
          <span class="opacity-30">/</span>
          <Link href="/work" class="nav-link relative px-3 py-1.5 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors duration-200">
            <span class="relative z-10">Work</span>
          </Link>
          <span class="opacity-30">/</span>
          <Link href="/projects" class="nav-link relative px-3 py-1.5 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors duration-200">
            <span class="relative z-10">Projects</span>
          </Link>
        </nav>
        
        <!-- Theme Toggle Button -->
        <button 
          id="theme-toggle" 
          class="p-2 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-all duration-200 hover:scale-110"
          aria-label="Toggle theme"
        >
          <svg id="sun-icon" xmlns="http://www.w3.org/2000/svg" class="size-5 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <svg id="moon-icon" xmlns="http://www.w3.org/2000/svg" class="size-5 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
      </div>
    </div>
  </Container>
</header>

<script>
  // Theme toggle functionality
  const themeToggle = document.getElementById('theme-toggle');
  const html = document.documentElement;
  
  // Check for saved theme preference or default to 'light'
  const currentTheme = localStorage.getItem('theme') || 'light';
  html.classList.toggle('dark', currentTheme === 'dark');
  
  themeToggle?.addEventListener('click', () => {
    html.classList.toggle('dark');
    const isDark = html.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });
</script>
