---
// Tag cloud component - dynamically fetches tags from blog posts
import { getCollection } from "astro:content";
import { slugify, tagHref } from "@lib/utils";

const posts = await getCollection("blog");

// Extract and count tags
const tagCount: Record<string, number> = {};
const tagDisplayNames: Record<string, string> = {};
posts.forEach(post => {
  if (post.data.tags && !post.data.draft) {
    post.data.tags.forEach(tag => {
      const slug = slugify(tag);
      tagCount[slug] = (tagCount[slug] || 0) + 1;
      if (!tagDisplayNames[slug]) {
        tagDisplayNames[slug] = tag;
      }
    });
  }
});

// Convert to array and sort by count
const tags = Object.entries(tagCount)
  .map(([slug, count]) => ({
    slug,
    displayName: tagDisplayNames[slug],
    count,
    // Determine size based on count
    size: count >= 5 ? "xl" : count >= 3 ? "lg" : count >= 2 ? "md" : "sm" as const,
  }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 15); // Limit to top 15 tags

const sizeClasses = {
  sm: "text-xs px-2 py-1",
  md: "text-sm px-3 py-1.5",
  lg: "text-base px-4 py-2",
  xl: "text-lg px-5 py-2.5 font-semibold",
};

const colors = [
  "from-blue-500/20 to-cyan-500/20 text-blue-700 dark:text-blue-300 border-blue-500/30",
  "from-purple-500/20 to-pink-500/20 text-purple-700 dark:text-purple-300 border-purple-500/30",
  "from-green-500/20 to-emerald-500/20 text-green-700 dark:text-green-300 border-green-500/30",
  "from-orange-500/20 to-red-500/20 text-orange-700 dark:text-orange-300 border-orange-500/30",
  "from-indigo-500/20 to-violet-500/20 text-indigo-700 dark:text-indigo-300 border-indigo-500/30",
  "from-amber-500/20 to-yellow-500/20 text-amber-700 dark:text-amber-300 border-amber-500/30",
];
---

<div class="tag-cloud animate p-5 rounded-xl border border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5">
  <h3 class="text-sm font-semibold text-black dark:text-white mb-4 flex items-center gap-2">
    <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
      <line x1="7" y1="7" x2="7.01" y2="7"/>
    </svg>
    Tags
  </h3>
  
  {tags.length === 0 ? (
    <p class="text-sm text-black/50 dark:text-white/50">No tags yet</p>
  ) : (
    <div class="flex flex-wrap gap-2">
      {tags.map((tag, index) => (
        <a 
          href={tagHref(tag.slug)}
          class={`tag-item inline-block rounded-full border bg-gradient-to-r ${colors[index % colors.length]} ${sizeClasses[tag.size]} hover:scale-110 hover:shadow-lg transition-all duration-300 animate-float`}
          style={`animation-delay: ${index * 0.1}s; animation-duration: ${3 + index * 0.2}s;`}
          title={`${tag.count} posts`}
        >
          {tag.displayName}
          <span class="ml-1 opacity-60 text-xs">({tag.count})</span>
        </a>
      ))}
    </div>
  )}
</div>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-5px); }
  }
  
  .animate-float {
    animation: float ease-in-out infinite;
  }
  
  .tag-item:hover {
    z-index: 10;
  }
</style>
