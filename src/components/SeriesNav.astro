---
import { getCollection } from "astro:content";
import FormattedDate from "@components/FormattedDate.astro";
import GlassCard from "@components/GlassCard.astro";

interface Props {
  series: string;
  currentSlug: string;
}

const { series, currentSlug } = Astro.props;

const seriesPosts = (await getCollection("blog"))
  .filter(post => !post.data.draft && post.data.series === series)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const currentIndex = seriesPosts.findIndex(post => post.slug === currentSlug);
const prevPost = currentIndex > 0 ? seriesPosts[currentIndex - 1] : null;
const nextPost = currentIndex < seriesPosts.length - 1 ? seriesPosts[currentIndex + 1] : null;
---

{seriesPosts.length > 0 && (
  <GlassCard glow class="mt-12" padding="p-6 md:p-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
      <div>
        <div class="text-xs font-medium text-black/50 dark:text-white/50 uppercase tracking-wider mb-1">Series</div>
        <h3 class="text-lg font-bold text-black dark:text-white text-gradient-subtle">{series}</h3>
        <div class="text-sm text-black/50 dark:text-white/50">
          Part {currentIndex + 1} of {seriesPosts.length}
        </div>
      </div>

      <div class="flex items-center gap-3">
        {prevPost ? (
          <a
            href={`/blog/${prevPost.slug}`}
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full border border-white/20 dark:border-white/10 bg-white/10 dark:bg-white/5 text-black/75 dark:text-white/85 hover:bg-white/20 dark:hover:bg-white/10 hover:scale-105 transition-all text-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            <span class="hidden sm:inline">Previous</span>
          </a>
        ) : (
          <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full border border-white/10 dark:border-white/5 text-black/30 dark:text-white/30 text-sm cursor-not-allowed">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            Previous
          </span>
        )}

        {nextPost ? (
          <a
            href={`/blog/${nextPost.slug}`}
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-gradient-to-r from-blue-600 to-purple-600 text-white text-sm font-medium hover:shadow-lg hover:shadow-blue-500/25 hover:scale-105 transition-all"
          >
            <span class="hidden sm:inline">Next</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        ) : (
          <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white/5 dark:bg-white/5 text-black/30 dark:text-white/30 text-sm cursor-not-allowed">
            Next
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </span>
        )}
      </div>
    </div>

    <nav class="space-y-1">
      {seriesPosts.map((post, index) => {
        const isCurrent = post.slug === currentSlug;
        return (
          <a
            href={`/blog/${post.slug}`}
            class={`flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm transition-all ${
              isCurrent
                ? "bg-white/20 dark:bg-white/10 text-black dark:text-white font-medium border border-white/20 dark:border-white/10"
                : "text-black/60 dark:text-white/60 hover:bg-white/10 dark:hover:bg-white/5"
            }`}
          >
            <span class={`flex-shrink-0 w-6 h-6 rounded-full flex items-center justify-center text-xs ${
              isCurrent
                ? "bg-gradient-to-br from-blue-500 to-purple-600 text-white shadow-md"
                : "bg-white/10 dark:bg-white/10 text-black/50 dark:text-white/50"
            }`}>
              {index + 1}
            </span>
            <span class="flex-1 truncate">{post.data.title}</span>
            <span class="hidden sm:block text-xs text-black/40 dark:text-white/40 shrink-0">
              <FormattedDate date={post.data.date} />
            </span>
          </a>
        );
      })}
    </nav>
  </GlassCard>
)}
