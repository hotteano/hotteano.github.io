---
import { getCollection } from "astro:content";
import PageLayout from "./PageLayout.astro";
import Container from "@components/Container.astro";
import TableOfContents from "@components/TableOfContents.astro";
import ProfileCard from "@components/ProfileCard.astro";
import TagCloud from "@components/TagCloud.astro";
import GlassCard from "@components/GlassCard.astro";
import FormattedDate from "@components/FormattedDate.astro";
import BackToPrev from "@components/BackToPrev.astro";
import Comments from "@components/Comments.astro";
import SeriesNav from "@components/SeriesNav.astro";
import { readingTime, slugify, tagHref } from "@lib/utils";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await post.render();

const allBlog = (await getCollection("blog")).filter(p => !p.data.draft);
const allProjects = (await getCollection("projects")).filter(p => !p.data.draft);
const allwork = await getCollection("work");
---

<PageLayout title={post.data.title} description={post.data.description} showSidebar={true}>
  <Container>
    <div class="flex justify-center">
      <!-- Main Content -->
      <div class="w-full max-w-5xl">
        <div class="animate mb-8">
          <BackToPrev href="/blog">
            Back to blog
          </BackToPrev>
        </div>

        <!-- Post Header -->
        <div class="space-y-5 mb-10">
          <div class="animate flex items-center gap-3 text-sm">
            <span class="badge-tech">
              <FormattedDate date={post.data.date} />
            </span>
            <span class="text-black/30 dark:text-white/30">•</span>
            <span class="text-black/50 dark:text-white/50">{readingTime(post.body)}</span>
            {post.data.column && (
              <>
                <span class="text-black/30 dark:text-white/30">•</span>
                <a
                  href={`/blog/column/${encodeURIComponent(post.data.column)}`}
                  class="badge-tech hover:text-black dark:hover:text-white"
                >
                  {post.data.column}
                </a>
              </>
            )}
            {post.data.track && (
              <>
                <span class="text-black/30 dark:text-white/30">•</span>
                <a
                  href={`/blog/${post.data.track}`}
                  class="badge-tech hover:text-black dark:hover:text-white"
                >
                  学习路线
                </a>
              </>
            )}
          </div>

          <h1 class="animate text-3xl md:text-5xl font-bold text-black dark:text-white leading-tight bg-gradient-to-r from-black dark:from-white to-black/70 dark:to-white/70 bg-clip-text">
            {post.data.title}
          </h1>

          <p class="animate text-lg md:text-xl text-black/70 dark:text-white/80 leading-relaxed">
            {post.data.description}
          </p>

          <!-- Tags -->
          {post.data.tags && (
            <div class="animate flex flex-wrap gap-2">
              {post.data.tags.map((tag: string) => (
                <a
                  href={tagHref(tag)}
                  class="badge-tech hover:text-black dark:hover:text-white"
                >
                  {tag}
                </a>
              ))}
            </div>
          )}
        </div>

        <!-- Article Content in Glass Card -->
        <GlassCard glow padding="p-6 md:p-10" class="article-glass mb-10">
          <article class="prose dark:prose-invert prose-p:text-black/85 dark:prose-p:text-white/90 prose-strong:text-black dark:prose-strong:text-white prose-li:text-black/85 dark:prose-li:text-white/90 w-full max-w-none overflow-x-auto">
            <Content />
          </article>
        </GlassCard>

        <!-- Series Navigation -->
        {post.data.series && (
          <div class="mb-10">
            <SeriesNav series={post.data.series} currentSlug={post.slug} />
          </div>
        )}

        <!-- Comments -->
        <Comments />
      </div>

      <!-- Sidebar -->
      <aside class="hidden xl:block ml-16 w-64 flex-shrink-0">
        <div class="sticky top-24 space-y-8 pb-8">
          <ProfileCard postCount={allBlog.length} projectCount={allProjects.length} pubCount={allwork.length} />
          <TableOfContents />
          <TagCloud />
        </div>
      </aside>
    </div>
  </Container>
</PageLayout>

<style>
  article.prose {
    width: 100%;
    max-width: 100%;
  }

  .prose pre {
    max-width: 100%;
    overflow-x: auto;
    border-radius: 0.75rem;
  }

  .prose table {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-radius: 0.75rem;
  }

  .prose img {
    max-width: 100%;
    height: auto;
    border-radius: 0.75rem;
  }
</style>
